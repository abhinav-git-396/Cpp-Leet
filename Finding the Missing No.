 class Solution {
 public:
     int missingNumber(vector<int>& nums) {
        int n = nums.size();
        int  totalSum = n*(n+1)/2;
        int sum = 0;
        for(int i = 0; i < nums.size(); i++){
          sum = sum + nums[i];
     }
     int lost = totalSum - sum;
     return lost;
     }
 };

//Second Method

class Solution {
public:
    int missingNumber(vector<int>& nums) {

        int n = nums.size();
        int ans = 0;

        for(int i = 0; i < n; i++) {
            ans = ans ^ nums[i] ^ (i + 1);
        }

        return ans;
    }
};
