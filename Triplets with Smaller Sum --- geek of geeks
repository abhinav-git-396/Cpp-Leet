class Solution {
	public:
	int countTriplets(int sum, vector<int>& nums) {
 
				int n = nums.size();
				sort(nums.begin(), nums.end());
			    int count = 0;
				
				for (int i = 0; i < n - 2; i++) {
 						
					
					int left = i + 1;
					int right = n - 1;
					
					while (left < right) {
						
						int target = nums[i] + nums[left] + nums[right];
						
 
						if (target < sum) {
						count += right - left;
						left++;
						}
						
						else {
							right--;
							
						}
						
					}
					
				}
				return count;
				
			}
		};
		
